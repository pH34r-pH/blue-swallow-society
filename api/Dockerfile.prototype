# Prototype only. If accepted, replace this filename with the normal product Dockerfile.
# Keep the floating Functions major/language tag so rebuilds receive Microsoft's
# supported base-image security updates; released product images are selected by
# our own immutable OCI digest.
FROM mcr.microsoft.com/azure-functions/node:4-node24

ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true

WORKDIR /home/site/wwwroot

COPY api/package.json api/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --engine-strict

COPY api/ ./
